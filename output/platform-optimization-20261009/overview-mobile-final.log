await (async page => { const table=page.getByRole("region",{name:"多周期概览表",exact:true}); await page.waitForFunction(()=>document.querySelector(".period-overview")?.getAttribute("aria-busy")==="false" && document.querySelectorAll(".period-overview tbody td").length===30,{},{timeout:60000}); const results=[]; for(const width of [390,320]) { await page.setViewportSize({width,height:844}); await table.scrollIntoViewIfNeeded(); const region=page.getByRole("region",{name:"多周期概览数据，可横向滚动",exact:true}); await region.focus(); await page.keyboard.press("ArrowRight"); const state=await region.evaluate(el=>({pageWidth:document.documentElement.scrollWidth,visible:el.clientWidth,tableWidth:el.scrollWidth,scrollLeft:el.scrollLeft})); results.push({width,...state}); await page.screenshot({path:`../output/playwright/period-overview-final-${width}.png`}); if(state.pageWidth>width || state.scrollLeft<=0 || state.tableWidth<=state.visible) throw Error(JSON.stringify(state)); await page.keyboard.press("ArrowLeft"); } console.log(JSON.stringify(results)); })(page);
