await (async page=>{const cloud=page.locator(".cloud-archives"),input=cloud.locator("input[type=file]");const listing=async()=>await(await page.request.get("http://127.0.0.1:8766/api/v1/research/archives")).json();const before=(await listing()).items.length;const choose=async file=>{await cloud.locator(".archive-toolbar button:not([disabled])").filter({hasText:"导入研究备份"}).waitFor();await input.setInputFiles(file);};const preview=page.getByRole("region",{name:"待导入研究备份",exact:true});await choose("../output/playwright/import-legacy-research.json");await preview.waitFor();if((await listing()).items.length!==before)throw Error("uploaded before confirmation");await preview.getByRole("button",{name:"取消导入",exact:true}).click();if((await listing()).items.length!==before)throw Error("cancel wrote record");await choose("../output/playwright/import-legacy-research.json");await preview.waitFor();await preview.getByRole("button",{name:"确认导入到当前账户",exact:true}).click();await cloud.getByText("已保存到当前账户，可在其他设备刷新云目录查看。",{exact:true}).waitFor();const list=await listing();const record=await(await page.request.get("http://127.0.0.1:8766/api/v1/research/archives/"+list.items[0].id)).json();if(list.items.length!==before+1||record.payload.owner!==undefined||record.payload.frontendVersion!=="legacy-test-v1"||record.payload.charts[0].bars[0].open!==1.123456789||!record.payload.charts[0].result.opaqueFutureField.mustRetain||record.payload.charts[0].frozenIndicators!==undefined)throw Error("payload changed");await choose("../output/playwright/import-invalid-research.json");await cloud.getByRole("alert").filter({hasText:"不支持此备份版本"}).waitFor();return {before,after:list.items.length,ownerBindingRemoved:true,originalVersionAndPrecisionKept:true,width:await page.evaluate(()=>document.documentElement.scrollWidth)};})(page);
