await (async(page)=>{const cloud=page.locator(".cloud-archives").first();await cloud.locator("li").first().getByRole("button",{name:"移入回收站",exact:true}).click();await cloud.getByText("已移入回收站，可恢复。",{exact:true}).waitFor();await cloud.getByRole("button",{name:"回收站",exact:true}).click();await cloud.getByRole("button",{name:"永久删除",exact:true}).click();if(await cloud.locator("li").count()!==1)throw Error("purged before confirmation");await cloud.getByRole("button",{name:"确认永久删除",exact:true}).click();await cloud.getByText("已永久删除云端内容，不能恢复；已有导出文件不受影响。",{exact:true}).waitFor();await cloud.getByText("回收站为空。",{exact:true}).waitFor();await cloud.getByRole("button",{name:"返回存档",exact:true}).click();const widths=[];for(const width of [1440,390,320]){await page.setViewportSize({width,height:1000});await cloud.scrollIntoViewIfNeeded();const actual=await page.evaluate(()=>document.documentElement.scrollWidth);if(actual>width)throw Error("overflow "+width);widths.push({width,actual});}await page.screenshot({path:"../output/playwright/cloud-library-320.png"});await cloud.locator("li").filter({hasText:"多周期研究"}).first().getByRole("button",{name:"查看原档",exact:true}).click();const dialog=page.getByRole("dialog",{name:"云端研究原档",exact:true});await dialog.waitFor();const box=await dialog.boundingBox();if(box.x<0||box.x+box.width>320||box.y<0||box.y+box.height>1000)throw Error("modal offscreen");await page.screenshot({path:"../output/playwright/cloud-study-320-final.png"});await dialog.getByRole("button",{name:"关闭云存档",exact:true}).click();return {confirmedPurge:true,widths,dialog:box};})(page);
