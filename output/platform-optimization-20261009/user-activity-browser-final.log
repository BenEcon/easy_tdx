    const after=(await (await other.request.get(`${base}/api/v1/auth/me`)).json()).user.preferences.tracking_groups;
    require(JSON.stringify(before)===JSON.stringify(after),'revocation destroyed data');
    checks.push({grantSave:true,revokeWriteStatus:denied.status(),originalGroupsRetained:true});
    const bars=Array.from({length:20},(_,i)=>({datetime:`2026-09-${String(i+1).padStart(2,'0')} 15:00:00`,open:10+i/10,high:11+i/10,low:9+i/10,close:10.5+i/10,vol:100,amount:1000,is_closed:true}));
