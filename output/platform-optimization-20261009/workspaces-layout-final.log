await (async (page) => { const nav=page.getByRole("navigation",{name:"缠论工作区"}); const widths=[]; for(const width of [1440,390,320]){await page.setViewportSize({width,height:1000}); for(const name of ["看图","研究","审核"]){await nav.getByRole("button",{name:new RegExp(name)}).click(); const actual=await page.evaluate(()=>document.documentElement.scrollWidth); widths.push({width,mode:name,actual}); if(actual>width)throw Error("overflow "+JSON.stringify(widths.at(-1))); }} await nav.getByRole("button",{name:/看图/}).click(); await nav.getByRole("button",{name:/看图/}).focus(); await page.keyboard.press("ArrowLeft"); if(await nav.getByRole("button",{name:/审核/}).getAttribute("aria-pressed")!=="true")throw Error("keyboard wrap"); await page.screenshot({path:"../output/playwright/workspaces-audit-320.png"}); return {widths,keyboard:"passed",saved:(await page.locator(".snapshot-list li").first().textContent())}; })(page);
