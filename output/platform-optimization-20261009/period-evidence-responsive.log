await (async (page) => { const panel=page.locator(".period-evidence"); const charts=page.getByRole("region",{name:"蜡烛图绘图区",exact:true}); const box=await charts.first().boundingBox(); await charts.first().click({position:{x:box.width*.7,y:180}}); await page.getByRole("button",{name:"查看所选日期证据",exact:true}).first().click(); const context=await panel.locator(".evidence-context").innerText(); const date=await panel.locator(".evidence-date-focus").innerText(); if(!context.includes("日线")||/图表日期 · .*[0-9]{2}:[0-9]{2}/.test(date)) throw Error(context+date); await panel.getByRole("button",{name:"返回图表",exact:true}).click(); const focused=await charts.first().evaluate(el=>el===document.activeElement); if(!focused)throw Error("wrong chart focus"); await panel.scrollIntoViewIfNeeded(); await page.screenshot({path:"../output/playwright/period-evidence-desktop.png"}); const widths=[]; for(const width of [390,320]){await page.setViewportSize({width,height:844}); await panel.scrollIntoViewIfNeeded(); await page.screenshot({path:`../output/playwright/period-evidence-${width}.png`}); const actual=await page.evaluate(()=>document.documentElement.scrollWidth); if(actual!==width)throw Error(`Overflow ${width} ${actual}`); widths.push({width,actual})}; return {context,date,focused,widths}; })(page);
