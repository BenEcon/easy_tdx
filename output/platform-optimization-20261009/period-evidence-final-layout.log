await (async (page) => { const errors=[]; const capture=e=>errors.push(String(e)); page.on("pageerror",capture); await page.getByRole("button",{name:"开始分析",exact:true}).click(); await page.getByRole("button",{name:"生成对比",exact:true}).click(); const charts=page.getByRole("region",{name:"蜡烛图绘图区",exact:true}); await charts.nth(1).waitFor(); const box=await charts.first().boundingBox(); await charts.first().click({position:{x:box.width*.7,y:180}}); await page.getByRole("button",{name:"查看所选日期证据",exact:true}).first().click(); const panel=page.locator(".period-evidence"); const row=panel.locator(".wave-diagnostic-row").first(); const widths=[]; for(const width of [1440,390,320]){ await page.setViewportSize({width,height:1000}); await panel.locator("summary").first().scrollIntoViewIfNeeded(); await page.screenshot({path:`../output/playwright/period-evidence-heading-${width}.png`}); await row.scrollIntoViewIfNeeded(); await page.screenshot({path:`../output/playwright/period-evidence-rows-${width}.png`}); const actual=await page.evaluate(()=>document.documentElement.scrollWidth); const display=await row.locator("summary").evaluate(el=>getComputedStyle(el).display); if(actual!==width||display!=="grid") throw Error(JSON.stringify({width,actual,display})); widths.push({width,actual,display}) }; page.off("pageerror",capture); if(errors.length) throw Error(errors.join(";")); return {widths,errors}; })(page);
