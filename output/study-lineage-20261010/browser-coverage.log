await (async (page) => {const requests=[],errors=[];const listener=r=>requests.push(new URL(r.url()).pathname);const failure=e=>errors.push(String(e));page.on("request",listener);page.on("pageerror",failure);try{await page.reload();const cloud=page.locator(".cloud-archives").first();await cloud.locator(":scope > summary").click();const sizes=[];for(const [index,label] of [[0,"failure"],[1,"table"]]){await cloud.getByRole("button",{name:"查看原档",exact:true}).nth(index).click();const dialog=page.getByRole("dialog",{name:"云端研究原档"});await dialog.getByText(index===0?/取数阶段全部失败，未调用研究计算/:/本次选定 5 个周期，1 个取得研究结果/).waitFor();for(const width of [1440,390,320]){await page.setViewportSize({width,height:1000});sizes.push(await page.evaluate(()=>({width:innerWidth,scroll:document.documentElement.scrollWidth})));await page.screenshot({path:`/Users/bowen/Documents/Python/Google/TDX-work/output/playwright/study-lineage-${label}-${width}.png`})}await dialog.getByRole("button",{name:"关闭云存档",exact:true}).click()}const forbidden=requests.filter(p=>/scan-evidence|\/bars(?:\/|$)|\/chanlun\/(?:replay|observations|archive-recompute)|\/indicator\/compute/.test(p));if(forbidden.length||errors.length||sizes.some(s=>s.scroll>s.width+1))throw Error(JSON.stringify({forbidden,errors,sizes}));return {sizes,forbidden,errors}}finally{page.off("request",listener);page.off("pageerror",failure)}})(page);
